{
  "name": "reactor-course",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate": "python scripts/generate-from-transcripts.py",
    "register-course": "python scripts/register-course.py",
    "build-course": "powershell -ExecutionPolicy Bypass -File scripts/build-course.ps1",
    "build-course:dry": "powershell -ExecutionPolicy Bypass -File scripts/build-course.ps1 -DryRun",
    "build-course:ollama": "powershell -ExecutionPolicy Bypass -File scripts/build-course.ps1 -Ollama",
    "generate-from-curriculum": "python scripts/generate-from-curriculum.py",
    "build-batch": "powershell -ExecutionPolicy Bypass -File scripts/build-batch-course.ps1",
    "build-batch:dry": "powershell -ExecutionPolicy Bypass -File scripts/build-batch-course.ps1 -DryRun",
    "build-batch:section": "powershell -ExecutionPolicy Bypass -File scripts/build-batch-course.ps1 -SkipBuild",
    "build-batch:ollama": "powershell -ExecutionPolicy Bypass -File scripts/build-batch-course.ps1 -Ollama"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
